#!/bin/bash
# git-credential-sixways: guarded git credential helper for the SixWays
# sandbox images (brokered git, spec 5.4).
#
# Purpose: baked into every image as the system-level `credential.helper`.
# When the SixWays endpoint launches the container it bind-mounts the
# host-side broker shim read-only at /usr/local/bin/sixways-git-shim; this
# wrapper delegates to it (`sixways-git-shim credential <op>`), which returns
# read-scoped tokens for fetch/pull and nothing for push (pushes are
# brokered host-side). When the shim is NOT mounted (standalone `docker
# run`, image smoke tests, third-party use) the wrapper consumes the
# request and returns no credentials, so git falls through to its normal behavior.
# It must stay silent in that case: a failing helper would print a warning
# on every credentialed git operation.
#
# The endpoint also injects GIT_CONFIG_* variables at launch
# (command scope beats system scope), so nothing baked here can override
# the endpoint's launch-time decisions.
#
# Usage (invoked by git): git-credential-sixways <get|store|erase>
set -uo pipefail

SHIM=/usr/local/bin/sixways-git-shim

if [ -x "$SHIM" ]; then
    exec "$SHIM" credential "$@"
fi

# Shim absent: consume the request per the credential-helper protocol and
# return nothing (exit 0, no output => git tries its next source).
cat >/dev/null
exit 0
